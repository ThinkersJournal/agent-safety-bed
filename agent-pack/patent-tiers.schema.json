{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ThinkersJournal/agent-safety-bed/main/agent-pack/patent-tiers.schema.json",
  "title": "agent-safety-bed patent-tiers.json",
  "type": "object",
  "required": ["_meta", "techniques"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_meta": {
      "type": "object",
      "required": ["date", "disclaimer", "entries", "tier_key", "action_key", "field_key"],
      "additionalProperties": false,
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "disclaimer": { "type": "string", "minLength": 1 },
        "entries": { "type": "integer", "minimum": 1 },
        "tier_key": {
          "type": "object",
          "required": ["T1", "T2", "T3", "T4", "T5"],
          "additionalProperties": false,
          "properties": {
            "T1": { "type": "string", "minLength": 1 },
            "T2": { "type": "string", "minLength": 1 },
            "T3": { "type": "string", "minLength": 1 },
            "T4": { "type": "string", "minLength": 1 },
            "T5": { "type": "string", "minLength": 1 }
          }
        },
        "action_key": {
          "type": "object",
          "required": ["allow", "allow-with-conditions", "separate-component", "avoid", "flag-for-review"],
          "additionalProperties": false,
          "properties": {
            "allow": { "type": "string", "minLength": 1 },
            "allow-with-conditions": { "type": "string", "minLength": 1 },
            "separate-component": { "type": "string", "minLength": 1 },
            "avoid": { "type": "string", "minLength": 1 },
            "flag-for-review": { "type": "string", "minLength": 1 }
          }
        },
        "field_key": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "techniques": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/technique" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "match": {
      "type": "object",
      "required": ["cargo", "pypi", "npm", "maven"],
      "additionalProperties": false,
      "properties": {
        "cargo": { "$ref": "#/$defs/names" },
        "pypi": { "$ref": "#/$defs/names" },
        "npm": { "$ref": "#/$defs/names" },
        "maven": { "$ref": "#/$defs/names" }
      }
    },
    "names": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "tier": { "enum": ["T1", "T2", "T3", "T4", "T5"] },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "evidence": {
      "type": "object",
      "description": "One checked claim: what was claimed, where it was checked, when, and what was found. For an absence (kind=absence, e.g. no patents found) url is the search URL and method records database, query and blind spot.",
      "required": ["claim", "kind", "url", "accessed", "finding"],
      "additionalProperties": false,
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["license", "patent", "expiry", "assignee", "litigation", "pledge", "absence", "status", "other"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "accessed": { "$ref": "#/$defs/date" },
        "finding": { "enum": ["confirmed", "not-confirmed", "contradicted", "unreachable"] },
        "method": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "kind": { "const": "absence" } }, "required": ["kind"] },
      "then": { "required": ["method"], "properties": { "method": { "type": "string" } } }
    },
    "technique": {
      "type": "object",
      "required": ["id", "technique", "part", "branch", "license", "tier", "secondary_tiers", "caveats", "watch", "confidence", "action", "note", "researched", "match", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "technique": { "type": "string", "minLength": 1 },
        "part": { "enum": ["modern-ml", "classical-ai"] },
        "branch": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "tier": { "$ref": "#/$defs/tier" },
        "tier_label": { "type": "string", "minLength": 1 },
        "secondary_tiers": { "type": "array", "items": { "$ref": "#/$defs/tier" }, "uniqueItems": true },
        "caveats": { "$ref": "#/$defs/strings" },
        "watch": { "$ref": "#/$defs/strings" },
        "confidence": { "type": "string", "minLength": 1 },
        "action": { "enum": ["allow", "allow-with-conditions", "separate-component", "avoid", "flag-for-review"] },
        "note": { "type": "string", "minLength": 1 },
        "researched": { "$ref": "#/$defs/date" },
        "match": { "$ref": "#/$defs/match" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    }
  }
}
